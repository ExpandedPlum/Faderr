# Faderr works without this file: connect Plex, Lidarr and Last.fm, and set a
# login password, from the Settings page in the web UI.
#
# Anything set here overrides the web UI (and is shown read-only there).
# Uncomment only what you want to manage in this file.

# ── Connections (optional here; normally set in the web UI) ─────────────────
# PLEX_URL=http://192.168.1.x:32400
# PLEX_TOKEN=your_plex_token_here
# PLEX_MUSIC_LIBRARY=Music
# LIDARR_URL=http://192.168.1.x:8686
# LIDARR_API_KEY=your_lidarr_api_key_here
# LASTFM_API_KEY=your_lastfm_api_key_here

# ── Login ───────────────────────────────────────────────────────────────────
# The password is normally set in the web UI. Setting it here overrides that.
# FADERR_PASSWORD=
# FADERR_USERNAME=faderr

# ── Behaviour ───────────────────────────────────────────────────────────────
# Deletes wait this many seconds before running and can be undone meanwhile
# (default 300 = 5 minutes; 0 runs them immediately)
# DELETE_GRACE_SECONDS=300

# Add deleted artists to Lidarr's import list exclusions so import lists don't
# re-add and re-download them (default: true)
# LIDARR_ADD_IMPORT_EXCLUSION=true

# Name of the Plex playlist Faderr maintains (default: Artist Triage)
# TRIAGE_PLAYLIST_NAME=Artist Triage

# Where the database lives (default: triage.db next to app.py)
# DATABASE_URL=sqlite+aiosqlite:////var/lib/faderr/triage.db
