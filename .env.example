PLEX_URL=http://192.168.1.x:32400
PLEX_TOKEN=your_plex_token_here
PLEX_MUSIC_LIBRARY=Music
LASTFM_API_KEY=your_lastfm_api_key_here
LIDARR_URL=http://192.168.1.x:8686
LIDARR_API_KEY=your_lidarr_api_key_here

# Optional: require a login for the web UI (strongly recommended — without it,
# anyone who can reach Faderr can delete artists). Username defaults to "faderr".
FADERR_USERNAME=faderr
FADERR_PASSWORD=

# Deletes wait this many seconds before running and can be undone meanwhile
# (default 300 = 5 minutes; 0 runs them immediately)
DELETE_GRACE_SECONDS=300

# Add deleted artists to Lidarr's import list exclusions so import lists don't
# re-add and re-download them (default: true)
LIDARR_ADD_IMPORT_EXCLUSION=true
